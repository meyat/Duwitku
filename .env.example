# Database (PostgreSQL) - contoh untuk Supabase
# DATABASE_URL: dipakai aplikasi saat runtime, pakai "Transaction Pooler" (port 6543)
DATABASE_URL="postgresql://user:password@host:6543/dbname?schema=public"

# DIRECT_URL: dipakai Prisma CLI (generate/db push/migrate), WAJIB pakai koneksi
# langsung (port 5432), BUKAN pooler — kalau pakai pooler, proses "prisma db push"
# bisa hang/stuck tanpa error yang jelas. Ambil dari Supabase: Settings > Database
# > Connection string > tab "Direct connection"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-dengan-perintah: openssl rand -base64 32"

# App
NODE_ENV="development"

# Opsional: secret untuk trigger seed data demo lewat browser tanpa terminal
# Kunjungi /api/dev-seed?secret=NILAI_INI setelah deploy untuk isi data demo
SEED_SECRET="ganti-dengan-string-acak-punyamu"

# Secret buat proteksi endpoint cron (/api/cron/backup) supaya tidak bisa
# dipanggil sembarangan orang. Vercel otomatis kirim header ini kalau env
# var CRON_SECRET diisi di project settings - generate string acak sendiri.
CRON_SECRET="ganti-dengan-string-acak-lainnya"

# Resend - buat kirim email kode OTP (verifikasi daftar & lupa password)
# Daftar gratis di https://resend.com, ambil API key dari dashboard
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Alamat pengirim email. Kalau belum verifikasi domain sendiri di Resend,
# pakai "Duwitku <onboarding@resend.dev>" (bawaan Resend, hanya bisa kirim
# ke email akun Resend kamu sendiri selama domain belum diverifikasi).
RESEND_FROM_EMAIL="Duwitku <onboarding@resend.dev>"

# AI Assistant - Analisis Keuangan (opsional, fitur chat AI butuh ini buat aktif)
# User bisa pilih penyedia AI dari halaman Settings (dropdown "Penyedia AI"):
# "kenari" atau "sumopod". Isi kredensial provider yang kamu pakai di bawah.
# AI_DEFAULT_PROVIDER dipakai kalau field aiProvider di database masih kosong.
AI_DEFAULT_PROVIDER="kenari"

# --- Provider: Kenari.id (https://kenari.id) ---
KENARI_API_KEY="kn-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KENARI_BASE_URL="https://kenari.id/v1"
# Model ringan - dipakai buat chat/pertanyaan biasa (cepat & lebih murah)
KENARI_MODEL="gpt-oss-20b"
# Model berat (opsional) - dipakai OTOMATIS kalau pertanyaan user butuh
# reasoning/hitungan mendalam (proyeksi, skenario, perbandingan, dsb).
KENARI_MODEL_HEAVY="gpt-oss-120b"

# --- Provider: Sumopod ---
SUMOPOD_API_KEY="sp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUMOPOD_BASE_URL="https://ai.sumopod.com/v1"
SUMOPOD_MODEL="gpt-5.6-luna"
SUMOPOD_MODEL_HEAVY="gpt-5.6-terra"

# Batas maksimal pesan AI per user per hari, biar biaya gak jebol
AI_DAILY_LIMIT="20"
