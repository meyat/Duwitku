generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH & USER
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  avatarUrl     String?
  currency      String    @default("IDR")
  dateFormat    String    @default("DD/MM/YYYY")
  timezone      String    @default("Asia/Jakarta")
  language      String    @default("id")
  theme         String    @default("system") // light | dark | system
  weekStartsOn  Int       @default(1) // 0 = Sunday, 1 = Monday

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  transactions      Transaction[]
  categories        Category[]
  tags              Tag[]
  savingGoals       SavingGoal[]
  bills             Bill[]
  recurringItems    RecurringTransaction[]
  debts             Debt[]
  investments       Investment[]
  notifications     Notification[]
  notificationPrefs NotificationPreference?
  sessions          Session[]
  passwordResets    PasswordResetToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ============================================================
// CATEGORY & TAG
// ============================================================

enum TransactionType {
  INCOME
  EXPENSE
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  type      TransactionType
  icon      String          @default("Circle")
  color     String          @default("#2563EB")
  isDefault Boolean         @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]
  recurring    RecurringTransaction[]

  @@unique([userId, name, type])
  @@map("categories")
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

// ============================================================
// TRANSACTION
// ============================================================

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
  DEBIT_CARD
  CREDIT_CARD
  OTHER
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  title         String
  amount        Decimal         @db.Decimal(15, 2)
  type          TransactionType
  categoryId    String?
  date          DateTime
  paymentMethod PaymentMethod   @default(CASH)
  note          String?

  // Reference fields for auto-generated transactions (avoid duplicates)
  sourceType    String?         // "installment_payment" | "recurring" | "bill"
  sourceId      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     TransactionTag[]

  @@index([userId, date])
  @@index([userId, type])
  @@index([sourceType, sourceId])
  @@map("transactions")
}

// ============================================================
// SAVING GOAL
// ============================================================

enum SavingGoalStatus {
  ACTIVE
  ACHIEVED
  CANCELLED
}

model SavingGoal {
  id             String           @id @default(cuid())
  userId         String
  name           String
  targetAmount   Decimal          @db.Decimal(15, 2)
  currentAmount  Decimal          @default(0) @db.Decimal(15, 2)
  deadline       DateTime?
  icon           String?
  note           String?
  status         SavingGoalStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingContribution[]

  @@map("saving_goals")
}

model SavingContribution {
  id           String   @id @default(cuid())
  savingGoalId String
  amount       Decimal  @db.Decimal(15, 2) // positive = add, negative = withdraw
  note         String?
  date         DateTime @default(now())

  createdAt DateTime @default(now())

  savingGoal SavingGoal @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)

  @@map("saving_contributions")
}

// ============================================================
// BILL (single, non-recurring reminder)
// ============================================================

enum BillStatus {
  UNPAID
  PAID
  LATE
}

enum ReminderOffset {
  ON_DUE_DATE
  ONE_DAY_BEFORE
  THREE_DAYS_BEFORE
  SEVEN_DAYS_BEFORE
  CUSTOM
}

model Bill {
  id             String         @id @default(cuid())
  userId         String
  name           String
  amount         Decimal        @db.Decimal(15, 2)
  categoryId     String?
  dueDate        DateTime
  reminderOffset ReminderOffset @default(THREE_DAYS_BEFORE)
  customReminderAt DateTime?
  note           String?
  status         BillStatus     @default(UNPAID)
  paidAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
  @@map("bills")
}

// ============================================================
// RECURRING TRANSACTION
// ============================================================

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

model RecurringTransaction {
  id              String             @id @default(cuid())
  userId          String
  name            String
  amount          Decimal            @db.Decimal(15, 2)
  type            TransactionType
  categoryId      String?
  frequency       RecurringFrequency
  customIntervalDays Int?
  startDate       DateTime
  endDate         DateTime?
  nextRunDate     DateTime
  requireConfirmation Boolean        @default(false)
  reminderOffset  ReminderOffset     @default(ON_DUE_DATE)
  isActive        Boolean            @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, nextRunDate])
  @@map("recurring_transactions")
}

// ============================================================
// DEBT / RECEIVABLE (Utang & Piutang) with Installments
// ============================================================

enum DebtType {
  DEBT       // utang (I owe)
  RECEIVABLE // piutang (owed to me)
}

enum InstallmentSystem {
  AUTOMATIC
  MANUAL
}

enum DebtOverallStatus {
  ACTIVE
  NOT_STARTED
  PARTIALLY_PAID
  PAID_OFF
  LATE
  CANCELLED
}

model Debt {
  id                String            @id @default(cuid())
  userId            String
  title             String
  counterpartyName  String
  type              DebtType
  totalAmount       Decimal           @db.Decimal(15, 2)
  startDate         DateTime
  dueDate           DateTime?
  contactNumber     String?
  note              String?
  paymentMethod     PaymentMethod     @default(CASH)
  installmentSystem InstallmentSystem @default(AUTOMATIC)
  downPayment       Decimal           @default(0) @db.Decimal(15, 2)
  status            DebtOverallStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([userId, type, status])
  @@map("debts")
}

enum InstallmentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  LATE
  SKIPPED
  CANCELLED
}

model Installment {
  id            String            @id @default(cuid())
  debtId        String
  installmentNo Int
  dueDate       DateTime
  billedAmount  Decimal           @db.Decimal(15, 2)
  paidAmount    Decimal           @default(0) @db.Decimal(15, 2)
  status        InstallmentStatus @default(UNPAID)
  reminderOffset ReminderOffset   @default(THREE_DAYS_BEFORE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  debt     Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([debtId, installmentNo])
  @@index([debtId, dueDate])
  @@map("installments")
}

model Payment {
  id              String        @id @default(cuid())
  installmentId   String
  expectedAmount  Decimal       @db.Decimal(15, 2)
  paidAmount      Decimal       @db.Decimal(15, 2)
  paymentDate     DateTime
  paymentMethod   PaymentMethod @default(CASH)
  note            String?
  proofUrl        String?
  balanceBefore   Decimal       @db.Decimal(15, 2)
  balanceAfter    Decimal       @db.Decimal(15, 2)

  // Link to auto-generated transaction to prevent duplicates
  transactionId   String?       @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cancelledAt DateTime?

  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([installmentId])
  @@map("payments")
}

// ============================================================
// INVESTMENT
// ============================================================

enum InvestmentType {
  STOCK
  CRYPTO
  BOND
  MUTUAL_FUND
  GOLD
}

model Investment {
  id             String         @id @default(cuid())
  userId         String
  name           String
  symbol         String?
  type           InvestmentType
  units          Decimal        @db.Decimal(20, 8)
  avgBuyPrice    Decimal        @db.Decimal(15, 2)
  currentPrice   Decimal        @db.Decimal(15, 2)
  purchaseDate   DateTime
  note           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("investments")
}

// ============================================================
// NOTIFICATION
// ============================================================

enum NotificationType {
  BILL_DUE_SOON
  BILL_LATE
  DEBT_DUE_SOON
  RECEIVABLE_DUE_SOON
  INSTALLMENT_DUE_SOON
  INSTALLMENT_LATE
  INSTALLMENT_PARTIAL
  DEBT_PAID_OFF
  SAVING_GOAL_DEADLINE_SOON
  SAVING_GOAL_ACHIEVED
  RECURRING_CREATED
  IMPORT_COMPLETED
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean           @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id                       String  @id @default(cuid())
  userId                   String  @unique
  browserNotification      Boolean @default(true)
  billReminder             Boolean @default(true)
  debtReminder             Boolean @default(true)
  savingGoalReminder       Boolean @default(true)
  recurringNotification    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ============================================================
// CSV IMPORT LOG (prevent duplicate imports)
// ============================================================

model ImportLog {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  rowHash     String   // hash of row content to detect duplicates
  totalRows   Int
  validRows   Int
  invalidRows Int
  createdAt   DateTime @default(now())

  @@index([userId, rowHash])
  @@map("import_logs")
}
